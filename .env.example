# Server Port
PORT=3000
NODE_ENV=development

# MongoDB Atlas Free Tier (M0) Connection URI
# 1. Sign up at https://www.mongodb.com/cloud/atlas/register
# 2. Deploy a free M0 cluster
# 3. Create a database user (Username & Password)
# 4. In Network Access, allow IP Address: 0.0.0.0/0 (allow from anywhere)
# 5. Click "Connect" -> "Drivers" (Node.js) -> Copy connection string
# 6. Paste below replacing <db_username> and <db_password>
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/taskpulse?retryWrites=true&w=majority
